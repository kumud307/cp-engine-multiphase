# Replit configuration: the Run button starts the web interface of the Cp engine.
run = "python3 webapp/server.py"
entrypoint = "webapp/server.py"
modules = ["python-3.11"]

[nix]
channel = "stable-24_05"

[env]
PORT = "8080"

[[ports]]
localPort = 8080
externalPort = 80

[deployment]
run = ["python3", "webapp/server.py"]
deploymentTarget = "cloudrun"
